/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Loongson 2K0300 PAI ("LS2K300-PAI") development board.
 *
 * DDR starts at 0x9000_0000_0000_0000. The board is booted by u-boot, which
 * places the SPL / its own runtime in the upper part of the first 256 MB
 * window (CONFIG_SPL_TEXT_BASE = 0x9000_0000_0900_0000,
 * CONFIG_SYS_TEXT_BASE = 0x9000_0000_0EC0_0000).
 *
 * The board u-boot hands over with CRMD=0 (paging disabled, no direct map
 * window). The uImage carries the 32 bit entry point 0x0300_1844, which
 * u-boot resolves through the cached 0x9 window, so the image has to be
 * transferred to physical 0x0300_0000 ("tftpboot 0x03000000 zephyr.uImage;
 * bootm") while its linked address is 0x9000_0000_0300_0000. Zephyr programs
 * DMW0/DMW1 and enables PG in reset.S (CONFIG_LOONGARCH_BOOT_DMW_MODE), which
 * is what keeps 0x8000_0000_xxxx_xxxx uncached for MMIO and makes the 0x9
 * window cached RAM. The 96 MB window ends at 0x0900_0000, i.e. below the SPL
 * (physical 0x0900_0000).
 */

/dts-v1/;

#include <loongson/ls2k0300.dtsi>
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
	model = "loongson,ls2k300-pai";
	compatible = "loongson,ls2k300-pai";

	aliases {
		led0 = &led0;
	};

	/*
	 * Board LED, from the vendor kernel's device tree for this board. The
	 * board is the Loongson 2K0300 "先锋派" (Vanguard PI), described in
	 * arch/loongarch/boot/dts/ls2k300_vanguard_pi_common.dtsi:
	 *
	 *   leds {
	 *           led1 {
	 *                   label = "led1";
	 *                   gpios = <&gpio 54 GPIO_ACTIVE_LOW>;
	 *                   linux,default-trigger = "heartbeat";
	 *                   default-state = "on";
	 *           };
	 *   };
	 *
	 *   lcd_backlight: backlight {
	 *           gpios = <&gpio 43 GPIO_ACTIVE_HIGH>;   / * panel, not an LED * /
	 *   };
	 *
	 * Absolute GPIO54 is bank 1 pin 22 in this port, which splits the IP
	 * into banks of at most 32 pins. The vendor LED node carries no
	 * pinctrl-0, so the reset value of the mux block (function 0 = GPIO) is
	 * what the LED needs and no pinctrl state is required here either.
	 *
	 * This matches the board's u-boot device tree (u-boot/.../ls2k300_pai.dts),
	 * which also uses GPIO43 as the backlight.
	 */
	leds {
		compatible = "gpio-leds";

		led0: led_0 {
			gpios = <&gpio1 22 GPIO_ACTIVE_LOW>;	/* absolute GPIO54 */
			label = "led1";
		};
	};

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &ram0;
		/*
		 * The ST7735S TFT on SPI2 is the active display; switch this
		 * back to &ssd1306 to give the I2C1 OLED the LVGL/display
		 * samples again (both drivers stay enabled).
		 */
		zephyr,display = &lcd0;
	};

	ram0: memory@9000000003000000 {
		device_type = "memory";
		compatible = "mmio-sram";
		reg = <0x90000000 0x03000000 0x0 0x06000000>;
	};
};

/* Console: UART0 @ 115200n8 */
&uart0 {
	status = "okay";
};

/* Blinkable led0 needs the GPIO controller */
&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

/* GPIO64..95: enabled so the shell can drive any LED candidate in this bank */
&gpio2 {
	status = "okay";
};

/* GPIO96..105 */
&gpio3 {
	status = "okay";
};

/*
 * I2C0 on GPIO48 (SCL) and GPIO49 (SDA), both switched to their primary
 * function by the pin mux block. The bus needs external pull-ups; with none the
 * controller still runs and simply sees no targets. The other three controllers
 * share the same header pins (i2c1 on GPIO50/51, i2c2 on GPIO52/53, i2c3 on
 * GPIO54/55) and stay disabled until something uses them.
 */
&i2c0 {
	status = "okay";
};

/*
 * SSD1306 OLED on i2c1: GPIO50 = SCL, GPIO51 = SDA, both switched to the I2C
 * function by the pin mux block. The panel is the usual 128x64 module on its
 * default address 0x3c; the controller parameters follow the
 * seeed_xiao_expansion_board shield, which drives the same part.
 *
 * The bus does not drive itself: external pull-ups on SCL/SDA are required.
 * The controller runs at its 100 kHz default here; the panel also handles
 * 400 kHz, which needs a correspondingly stronger pull-up (override
 * clock-frequency in &i2c1 if the wiring supports it).
 *
 * With no panel attached the driver fails fast (the address byte is NACKed, so
 * it sees -ENXIO and not a bus timeout) and the display device simply stays
 * unready - the console is not affected.
 */
&i2c1 {
	status = "okay";

	ssd1306: ssd1306@3c {
		compatible = "solomon,ssd1306";
		reg = <0x3c>;
		/*
		 * Disabled while the ST7735S TFT is the active display (the
		 * OLED is unplugged; an enabled node would just log init
		 * failures at every boot). Set "okay" again - and point
		 * zephyr,display back at &ssd1306 - to use the OLED.
		 */
		status = "disabled";

		width = <128>;
		height = <64>;

		segment-offset = <0>;
		page-offset = <0>;
		display-offset = <0>;
		multiplex-ratio = <63>;
		prechargep = <0x22>;
		segment-remap;
		com-invdir;
	};
};

/*
 * Both SoC timer blocks as PWM sources, each with its PWM child enabled so that
 * the driver binds to it. Both run off the APB clock (100 MHz) and are driven
 * from the console - by node label, because the two blocks are separate
 * controllers and therefore separate PWM devices:
 *
 *   pwm frequency atim_pwm 3        # cycle unit of the ATIM (100000000)
 *   pwm usec atim_pwm 3 1000 500    # 1 kHz, 50 % on ATIM channel 3
 *   pwm usec gtim_pwm 1 2000 1000   # 500 Hz, 50 % on GTIM channel 2
 *
 * Zephyr numbers PWM channels from zero, so chip channel CH2 is index 1 and CH3
 * is index 2. Keep in mind that all channels of one block share the prescaler
 * and the reload register: a second channel on the same block may only be given
 * the same period (the driver refuses anything else with -EBUSY). The two blocks
 * are independent of each other, which is what makes two frequencies possible.
 *
 * ATIM channel 3 is muxed to GPIO83, the pin the vendor device tree calls
 * "atim3_pin_m1" and the pin Linux switches for the LCD backlight on the 99pi
 * board; "atim3_g30_default" is the same channel on GPIO30.
 *
 * GTIM channel 2 ("TIM2_CH2" in the vendor tables) is muxed to GPIO88, the
 * vendor's "gtim2_pin_m1"; "gtim2_g35_default" is the same channel on GPIO35.
 *
 * Both pins are free on this board: the LED is on GPIO54, the console on
 * GPIO40/41 and both I2C buses on GPIO48..51. A board that uses i2c2/i2c3 on
 * their alternative G82..G85 group must move the PWM channels elsewhere - the
 * SoC device tree lists the pins of all channels next to these states.
 */
&timers1 {
	status = "okay";
	/*
	 * Channel 3 and its complementary output: CH3 on GPIO83 (atim3_pin_m1)
	 * and CH3N on GPIO86 (atim3n_pin_m1), the pair the vendor device tree
	 * muxes for the 99pi's backlight. The driver drives both: configuring
	 * ATIM channel 3 enables CC3E and CC3NE, so the two pins output the
	 * complementary pair of one channel. Drop the second phandle if the
	 * board only needs the single-ended output, and note that no dead time
	 * is inserted between them (BDTR.DTG stays 0).
	 */
	pinctrl-0 = <&atim3_g83_default &atim3n_g86_default>;
	pinctrl-names = "default";
};

&atim_pwm {
	status = "okay";
};

&timers2 {
	status = "okay";
	pinctrl-0 = <&gtim2_g88_default>;
	pinctrl-names = "default";
};

&gtim_pwm {
	status = "okay";
};

/*
 * SPI0, the four interface pins G56 (clock), G57 (miso), G58 (mosi) and
 * G59 (chip select) - the group u-boot has already muxed to the SPI
 * function, so the board only names it. Bring-up is through the shell
 * (CONFIG_SPI_SHELL in the bring-up config).
 */
&spi0 {
	status = "okay";
	pinctrl-0 = <&spi0_g56_default &spi0_g57_default &spi0_g58_default
		     &spi0_g59_default>;
	pinctrl-names = "default";

	/*
	 * Bring-up probe: the SPI shell addresses DT devices, so the bus
	 * carries one placeholder at chip select 0 for the loopback test.
	 * Jumper MOSI (G58) to MISO (G57) and
	 *
	 *   spi transceive probe 0xaa
	 *
	 * reads back the byte it sent. Replace this node with the real
	 * peripheral once one is wired to the bus.
	 */
	probe: spi-probe@0 {
		compatible = "vnd,spi-device";
		reg = <0>;
		spi-max-frequency = <1000000>;
	};
};

/*
 * I2S controller, with the four interface pins it needs (bit clock, frame
 * clock, data in, data out). The MCLK pin (GPIO76) is left alone: this board
 * clocks its ES8388 codec from a fixed 12.288 MHz oscillator, so driving the
 * controller's MCLK output would put two drivers on that net.
 *
 * The codec itself cannot be brought up yet: Zephyr has no ES8388 driver, so
 * the controller is enabled for register-level checks and for the digital
 * loopback test - jumper data out (GPIO80) to data in (GPIO79) and run
 * samples/drivers/i2s/echo with the "i2s_rxtx" label this node carries.
 */
&i2s0 {
	status = "okay";
	/*
	 * The MCLK pin is part of the group: the codec takes its system clock
	 * from this controller, which is what the vendor kernel does by default
	 * (its driver only leaves MCLK alone when a board sets "mclk-external",
	 * and none of its board trees does - the fixed clock in their codec node
	 * is a placeholder their own comment calls unused in slave mode). The
	 * driver programs the fractional divider to 256 * frame rate, i.e.
	 * 12.288 MHz at 48 kHz, which is also the rate the codec node declares.
	 *
	 * A board that clocks its codec from its own oscillator instead must
	 * drop "mclk-output" and the MCLK pin from this group, or two drivers
	 * end up on that net.
	 */
	pinctrl-0 = <&i2s_mclk_g76_default &i2s_bclk_g77_default &i2s_lr_g78_default
		     &i2s_di_g79_default &i2s_do_g80_default>;
	pinctrl-names = "default";
	mclk-output;

	/*
	 * The codec's data out (G79, "datai" here) is an input to this
	 * controller, and the pin state only picks the function - it leaves the
	 * pad direction as the boot loader left it, which is an output on every
	 * one of these five pins. Left alone, the pad would drive the codec's
	 * data line against it; the driver switches this one to an input.
	 */
	loongson,data-in-gpios = <&gpio2 15 0>;
};

/*
 * ES8388 audio codec on i2c2 (SCL on GPIO52, SDA on GPIO53), address 0x11 -
 * the wiring the vendor device tree describes as "codec: es8388@11".
 *
 * Its system clock comes from a 12.288 MHz oscillator on the board rather than
 * from the I2S controller, and it is the target of the I2S clocks: the SoC
 * drives BCLK and LRCLK, exactly as the vendor machine driver configures the
 * link (SND_SOC_DAIFMT_CBS_CFS).
 *
 * Two labels: "es8388" for code that wants this part, "audio_codec" because
 * that is what the upstream samples look for.
 */
&i2c2 {
	status = "okay";

	es8388: audio_codec: es8388@11 {
		compatible = "everest,es8388";
		reg = <0x11>;
		mclk-frequency = <12288000>;
	};
};

/*
 * ST7735S TFT on SPI2: G64 = SCK, G66 = MOSI (G65/MISO unused by the panel),
 * CS = G67 as a GPIO (the ls-spi-io block has no chip select of its own),
 * DC = G68 and RES = G69 as plain GPIOs.
 *
 * The panel parameters follow the ST7735S values the Sipeed longan_nano board
 * ships (the same controller), with the 160x128 geometry of the common
 * module: x-offset 2, y-offset 1, landscape MADCTL (MV|RGB), display
 * inversion on. If the picture is shifted, rotated or the colors swap, the
 * knobs to try first are x-offset/y-offset, madctl, inversion-on and
 * rgb-is-inverted - ST7735S modules differ by tab color in exactly those.
 *
 * mipi-max-frequency is left at 4 MHz for jumper wires; a properly routed
 * board runs this panel at 20 MHz and more.
 */
&spi2 {
	status = "okay";
	pinctrl-0 = <&spi2_g64_default &spi2_g65_default &spi2_g66_default>;
	pinctrl-names = "default";
	cs-gpios = <&gpio2 3 GPIO_ACTIVE_LOW>;	/* G67 */
};

/ {
	mipi_dbi {
		compatible = "zephyr,mipi-dbi-spi";
		spi-dev = <&spi2>;
		dc-gpios = <&gpio2 4 GPIO_ACTIVE_HIGH>;	/* G68 */
		reset-gpios = <&gpio2 5 GPIO_ACTIVE_LOW>;	/* G69 */
		write-only;
		#address-cells = <1>;
		#size-cells = <0>;

		lcd0: lcd@0 {
			compatible = "sitronix,st7735r";
			reg = <0>;
			width = <160>;
			height = <128>;
			x-offset = <2>;
			y-offset = <1>;
			madctl = <0x60>;
			colmod = <0x05>;
			inversion-on;
			rgb-is-inverted;
			invctr = <3>;
			pwctr1 = [62 02 04];
			pwctr2 = [c0];
			pwctr3 = [0d 00];
			pwctr4 = [8d 6a];
			pwctr5 = [8d ee];
			frmctr1 = [05 3a 3a];
			frmctr2 = [05 3a 3a];
			frmctr3 = [05 3a 3a 05 3a 3a];
			vmctr1 = <0x14>;
			gamctrp1 = [10 0e 02 03 0e 07 02 07 0a 12 27 37 00 0d 0e 10];
			gamctrn1 = [10 0e 03 03 0f 06 02 08 0a 13 26 36 00 0d 0e 10];

			mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
			mipi-max-frequency = <4000000>;
		};
	};
};
