CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_STACK_SENTINEL=y

# The image is loaded into DDR (no execute in place)
CONFIG_XIP=n

# The LoongArch toolchain ships newlib instead of picolibc
CONFIG_MINIMAL_LIBC=y

# The LA264 core integrates an FPU
CONFIG_FPU=y

# EIOINTC ("EXTIOI") is the interrupt controller of the SoC: it gives every
# peripheral interrupt a vector of its own, where the legacy LIOINTC lines
# aggregate several sources each (uart2..uart5 share one line, for instance).
# It is the only controller this port models; the LIOINTC driver was removed
# once the EIOINTC took over.
CONFIG_INTC_EIOINTC=y

# The SoC has a battery backed RTC (the TOY wall clock the driver reads and
# writes); the driver follows its device tree node, but the RTC subsystem
# itself is off by default.
CONFIG_RTC=y

# PWM: the board muxes ATIM channel 3 (see the board device tree) and uses it
# through the "loongson,ls2k-pwm-timer" child of the "timers1" block.
CONFIG_PWM=y

# I2S: the board brings out the four interface pins of the controller.
CONFIG_I2S=y

# The board's audio codec is an ES8388 on i2c2, with the I2S controller as the
# master of the link. The audio codec class sits inside the "Audio drivers"
# menu, so that switch has to be on as well.
CONFIG_AUDIO=y
CONFIG_AUDIO_CODEC=y

# GPIO + gpio-leds (LED0 on GPIO43 = gpio1 pin 11)
CONFIG_GPIO=y
CONFIG_LED=y
