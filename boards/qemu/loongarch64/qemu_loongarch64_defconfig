CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_STACK_SENTINEL=y

CONFIG_XIP=n

# The current LoongArch toolchain ships newlib instead of picolibc, so use
# the Zephyr minimal C library by default (an application can still select
# picolibc, e.g. through CONFIG_PICOLIBC_USE_MODULE).
CONFIG_MINIMAL_LIBC=y

# The la464 core has an FPU; no sharing support implemented yet
CONFIG_FPU=y
