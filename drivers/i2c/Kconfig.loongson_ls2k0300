config I2C_LOONGSON_LS2K0300
	bool "Loongson 2K0300 I2C driver"
	default y
	depends on DT_HAS_LOONGSON_LS2K0300_I2C_ENABLED
	help
	  I2C controller driver for the Loongson 2K0300 "fast I2C" peripheral:
	  32 bit registers (CR1/CR2/DR/SR1/SR2/CCR/TRISE), start/stop/ack through
	  CR1, level status flags in SR1/SR2 - all polled, so no interrupt line is
	  needed:

	    i2c1: i2c@8000000016109000 {
	            compatible = "loongson,ls2k0300-i2c";
	            clocks = <&clk LS2K0300_CLK_I2C>;
	            clock-frequency = <100000>;
	            ...
	    };
